# AutoAssist AI - Environment Configuration Template
# Copy this file to .env and populate with your own project credentials.
# Do not commit .env to version control.

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Direct PostgreSQL connection string
# Found in: Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Embedding Model Configuration
# Standard sentence-transformers lightweight model: 384 dimensions
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
